{
  "name": "adventura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "import:srd:2024:features": "node scripts/import-srd-class-features.mjs",
    "import:srd:2014:features": "node scripts/import-srd-class-features-2014.mjs",
    "import:srd:2024:features:de": "node scripts/import-srd-class-features-2024-de.mjs",
    "import:srd:2014:features:de": "node scripts/import-srd-class-features-2014-de.mjs",
    "import:srd:2014:spells:de": "node scripts/import-srd-spells-2014-de.mjs",
    "import:srd:2014:spells:en": "node scripts/import-srd-spells-2014-en.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "i18next": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "latest",
    "react-router-dom": "latest",
    "tailwind-merge": "latest",
    "zod": "latest",
    "@radix-ui/react-select": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "prettier": "3.6.2"
  }
}
